# Copy to ghost/.env, fill in, then store in Secret Manager:
#   gcloud secrets versions add ghost-env --data-file=ghost/.env
# Never commit ghost/.env. The deploy script writes it on the VM from Secret Manager.

# Optional containers: analytics (Tinybird) and/or activitypub (social web)
# COMPOSE_PROFILES=analytics,activitypub

# Public domain Ghost runs on (Caddy requests the TLS cert for it)
DOMAIN=blog.creativecaptains.com

# Separate admin domain (also uncomment the block in caddy/Caddyfile)
# ADMIN_DOMAIN=

HTTP_PORT=80
HTTPS_PORT=443

# Database. Do not change after the first boot. Generate with: openssl rand -hex 32
DATABASE_ROOT_PASSWORD=CHANGE_ME
DATABASE_PASSWORD=CHANGE_ME
# DATABASE_USER=ghost

# Self-host ActivityPub instead of using ap.ghost.org
# ACTIVITYPUB_TARGET=activitypub:8080

# Tinybird analytics (output of: docker compose run --rm tinybird-login get-tokens)
# TINYBIRD_API_URL=https://api.tinybird.co
# TINYBIRD_TRACKER_TOKEN=
# TINYBIRD_ADMIN_TOKEN=
# TINYBIRD_WORKSPACE_ID=
# TINYBIRD_SYNC_AUTH=

# Transactional SMTP (https://ghost.org/docs/config/#mail)
# Required for admin logins, staff invites and password resets.
# This is NOT newsletter sending; newsletters are configured with Mailgun inside Ghost Admin.
mail__transport=SMTP
mail__options__host=smtp.example.com
mail__options__port=465
mail__options__secure=true
mail__options__auth__user=postmaster@example.com
mail__options__auth__pass=CHANGE_ME
mail__from="'Creative Captains' <hello@creativecaptains.com>"

# Pin a Ghost version only if you must. Default tracks the 6.x alpine tag.
# GHOST_VERSION=6-alpine

# Persistent data lives on the attached data disk (see terraform/vm.tf and cloud-init.yaml)
UPLOAD_LOCATION=/mnt/ghost-data/ghost
MYSQL_DATA_LOCATION=/mnt/ghost-data/mysql
